# Local free demo OTP: it is displayed inside the local dashboard and sends no SMS.
# Never use screen mode on a public deployment.
OTP_DELIVERY_MODE=screen
OTP_SCREEN_SECRET=change-this-local-development-secret

# For real SMS OTP, set OTP_DELIVERY_MODE=twilio and add Twilio credentials below.
# Never commit a populated .env file.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_your_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Required only for farmers who opt in to government-scheme SMS notifications.
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# A long random secret used by your admin job to publish verified scheme alerts.
SCHEME_ADMIN_KEY=replace_with_a_long_random_secret

# Kisan Mitra AI (server-side only; never paste this key into dashboard.py).
# Gemini's Free Tier has request limits. In the free tier, Google may use
# prompts/responses to improve its products; do not use it for sensitive data.
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TRANSCRIPTION_MODEL=gemini-3.6-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
